<?xml version='1.0'?>
<!DOCTYPE fontconfig SYSTEM 'urn:fontconfig:fonts.dtd'>
<fontconfig>
    <!-- patterns -->
    <match target="pattern">
        <test name="family" qual="any">
            <string>sans-serif</string>
        </test>
        <edit mode="assign" name="family" binding="same">
            <string>#{ return conf.font.serif }</string>
        </edit>
    </match>
    <match target="pattern">
        <test name="family" qual="any">
            <string>serif</string>
        </test>
        <edit mode="assign" name="family" binding="same">
            <string>#{ return conf.font.serif }</string>
        </edit>
    </match>
    <match target="pattern">
        <test name="family" qual="any">
            <string>monospace</string>
        </test>
        <edit mode="assign" name="family" binding="same">
            <string>#{ return conf.font.mono }</string>
        </edit>
    </match>

    <!-- scan -->
    <match target="scan">
        <test name="family" qual="any">
            <string>#{ return conf.font.mono }</string>
        </test>
        <edit mode="assign" name="spacing">
            <int>100</int>
        </edit>
    </match>

</fontconfig>
